PORT=5000

# Local MongoDB now, replace with your MongoDB Atlas connection string later
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=library_management

# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend address allowed by CORS (comma separate multiple URLs)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Used only by "npm run create-admin" to create the first librarian account
ADMIN_NAME=Librarian
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary keys for book cover uploads (from your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
